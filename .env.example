# Discord bot token — Developer Portal → your app → Bot → Reset Token.
# Never commit the real value; .env is gitignored.
DISCORD_TOKEN=your-bot-token-here

# Application (client) id — Developer Portal → your app → General Information.
CLIENT_ID=123456789012345678

# Note: the home guild (the only server CuffBot serves) is NOT an env var —
# it is a non-secret product setting in config.json → homeGuildId.

# ── Detective (AI) module — optional ────────────────────────────────────────
# Add ONE free-tier API key and restart; without a key the AI commands reply
# "not configured" and everything else works normally.
#   Groq:   https://console.groq.com  → API Keys → Create API Key
#   Gemini: https://aistudio.google.com → Get API key
# GROQ_API_KEY=gsk_your-key-here
# GEMINI_API_KEY=your-key-here
#
# GROQ_API_KEY is used TWICE: the AI conversation above, and the transcription
# desk (S101) that turns voice memos into written statements. Only Groq hosts
# Whisper, so the transcription half needs that specific key — with only a
# Gemini key the AI works and `!transcribe` says it is not configured.

# Optional: pin the provider ("groq" or "gemini") when both keys are set,
# and/or override the model name. Defaults: groq → llama-3.1-8b-instant,
# gemini → gemini-2.5-flash-lite (owner decision 2026-07-24).
# CUFFBOT_AI_PROVIDER=gemini
# CUFFBOT_AI_MODEL=gemini-2.5-flash-lite

# Optional: override the bot-side DAILY request cap that protects the
# provider's free-tier RPD quota (defaults: gemini 20/day, groq 14400/day —
# both from the providers' free tiers). 0 disables the daily cap.
# CUFFBOT_AI_DAILY_LIMIT=20

# ── Operational overrides — optional, rarely needed ─────────────────────────
# Where the per-guild JSON store lives. Defaults to ./data next to the repo;
# the test suite points it at a temp directory so a test run can never touch
# real member data.
# CUFFBOT_DATA_DIR=/home/pi/cuffbot-data
#
# Log verbosity: error | warn | info (default) | debug.
# LOG_LEVEL=info
